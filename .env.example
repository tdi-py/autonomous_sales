# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/autonomous_sales

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
WORKER_PORT=3002
WEB_URL=http://localhost:3000
API_DOMAIN=http://localhost:3001/api

# ─── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production
NEXTAUTH_SECRET=change-me-in-production
NEXTAUTH_URL=http://localhost:3000

# ─── LLM Provider ────────────────────────────────────────────────────────────
# Options: groq | ollama
LLM_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key-here

# Ollama (only if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434

# ─── Faz 2.5 — Email Deliverability (Seed Test) ──────────────────────────────
# Optional: seed Gmail account for inbox/spam testing
SEED_TEST_GMAIL=your-seed-gmail@gmail.com
SEED_TEST_GMAIL_PASSWORD=gmail-app-password

# Optional: seed Outlook account
SEED_TEST_OUTLOOK=your-seed-outlook@outlook.com
SEED_TEST_OUTLOOK_PASSWORD=outlook-password

# ─── Faz 4 — Phone Verification ──────────────────────────────────────────────
# Optional: Twilio Lookup API (for number type detection)
# If not set → number type = "unknown", classification = "can_call_manual"
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token

# ─── Faz 4 — Vapi.ai (AI Voice Calls) ────────────────────────────────────────
# Optional: if not set → AI calls disabled, script-only mode active
VAPI_API_KEY=your-vapi-api-key
VAPI_PHONE_NUMBER_ID=your-vapi-phone-number-id
# Webhook secret for verifying Vapi webhook requests
VAPI_WEBHOOK_SECRET=your-vapi-webhook-secret
# Register this URL in Vapi dashboard:
# VAPI_WEBHOOK_URL=https://your-api-domain.com/api/webhooks/vapi

# ─── Next.js ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001/api
